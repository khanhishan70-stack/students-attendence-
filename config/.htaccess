# SMART ATTENDANCE AI
# Local credentials live in this folder. Block every direct HTTP request to it.
# The application still works: PHP includes these files from the file system,
# not over HTTP.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
